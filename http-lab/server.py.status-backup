from http.server import BaseHTTPRequestHandler, HTTPServer


class Handler(BaseHTTPRequestHandler):

    def send_text(self, status, message):
        body = message.encode()

        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()

        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/":
            self.send_text(200, "OK - Cyber Lab")

        elif self.path == "/not-found":
            self.send_text(404, "404 - Not Found")

        elif self.path == "/forbidden":
            self.send_text(403, "403 - Forbidden")

        elif self.path == "/error":
            self.send_text(500, "500 - Internal Server Error")

        else:
            self.send_text(404, "404 - Not Found")


server = HTTPServer(("127.0.0.1", 9093), Handler)

print("Cyber Lab status server running on 127.0.0.1:9093")

server.serve_forever()
