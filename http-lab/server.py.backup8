from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs


class Handler(BaseHTTPRequestHandler):

    def log_message(self, format, *args):
        timestamp = self.log_date_time_string()
        client_ip = self.client_address[0]
        print(
            f"[HTTP] {timestamp} {client_ip} "
            f"{self.command} {self.path} -> {args[1]}"
        )


    def send_text(self, body, status=200):
        body = body.encode("utf-8")

        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_HEAD(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path != "/test":
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return

        body = (
            f"Method: HEAD\n"
            f"Path: {path}\n"
        ).encode("utf-8")

        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()

    def _send_json(self, obj, status=200):
        import json
        body = json.dumps(obj).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)
        if path == "/status":
            body = '{"status":"ok","lab":"cyber","server":"http-lab"}'.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return


        user = self.headers.get("X-Lab-User", "not provided")
        test = self.headers.get("X-Lab-Test", "not provided")

        if path == "/echo":
            self._send_json({
                "method": self.command,
                "path": path,
                "query": query,
                "headers": dict(self.headers),
            })
            return

        if path != "/test":
            body = '{"error":"not_found","path":"' + path + '"}'
            body = body.encode("utf-8")
            self.send_response(404)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        body = (
            f"Method: GET\n"
            f"Path: {path}\n"
            f"Query: {query}\n\n"
            f"User: {user}\n"
            f"Test: {test}\n"
        )

        self.send_text(body)

    def do_PUT(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        user = self.headers.get("X-Lab-User", "not provided")

        length = int(self.headers.get("Content-Length", "0"))
        data = self.rfile.read(length).decode("utf-8", errors="replace")

        if path == "/echo":
            self._send_json({
                "method": self.command,
                "path": path,
                "query": query,
                "headers": dict(self.headers),
                "body": data,
            })
            return

        if path != "/api":
            body = '{"error":"not_found","path":"' + path + '"}'
            body = body.encode("utf-8")
            self.send_response(404)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        body = (
            f"Method: PUT\n"
            f"Path: {path}\n"
            f"Query: {query}\n\n"
            f"User: {user}\n"
            f"Body: {data}\n"
        )

        self.send_text(body)

    def do_DELETE(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        user = self.headers.get("X-Lab-User", "not provided")

        if path != "/api":
            body = '{"error":"not_found","path":"' + path + '"}'
            body = body.encode("utf-8")
            self.send_response(404)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        body = (
            f"Method: DELETE\n"
            f"Path: {path}\n"
            f"Query: {query}\n\n"
            f"User: {user}\n"
        )

        self.send_text(body)

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        user = self.headers.get("X-Lab-User", "not provided")
        test = self.headers.get("X-Lab-Test", "not provided")

        length = int(self.headers.get("Content-Length", "0"))
        data = self.rfile.read(length).decode("utf-8", errors="replace")

        if path == "/echo":
            self._send_json({
                "method": self.command,
                "path": path,
                "query": query,
                "headers": dict(self.headers),
                "body": data,
            })
            return

        if path != "/api":
            body = '{"error":"not_found","path":"' + path + '"}'
            body = body.encode("utf-8")
            self.send_response(404)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        body = (
            f"Method: POST\n"
            f"Path: {path}\n"
            f"Query: {query}\n\n"
            f"User: {user}\n"
            f"Test: {test}\n"
            f"Body: {data}\n"
        )

        self.send_text(body)


server = HTTPServer(("127.0.0.1", 9093), Handler)

print("Cyber Lab server running on 127.0.0.1:9093")

server.serve_forever()
