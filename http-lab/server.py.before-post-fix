from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs


class Handler(BaseHTTPRequestHandler):

    def send_text(self, body, status=200):
        body = body.encode()

        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()

        self.wfile.write(body)

    def do_GET(self):
        user = self.headers.get("X-Lab-User", "not provided")
        test = self.headers.get("X-Lab-Test", "not provided")

        path = urlparse(self.path).path
        query = parse_qs(urlparse(self.path).query)

        if path in ("/test", "/api", "/"):
            body = (
                f"Method: GET\n"
                f"Path: {path}\n"
                f"Query: {query}\n\n"
                f"User: {user}\n"
                f"Test: {test}\n"
            )
            self.send_text(body)
        else:
            self.send_text("Not Found\n", 404)

    def do_POST(self):
        user = self.headers.get("X-Lab-User", "not provided")

        length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(length).decode("utf-8", errors="replace")

        path = urlparse(self.path).path

        if path == "/api":
            body = (
                f"Method: POST\n"
                f"Path: {path}\n"
                f"Query: {query}\n\n"
                f"User: {user}\n"
                f"Data: {data}\n"
            )
            self.send_text(body)
        else:
            self.send_text("Not Found\n", 404)


server = HTTPServer(("127.0.0.1", 9093), Handler)

print("Cyber Lab server running on 127.0.0.1:9093")

server.serve_forever()
